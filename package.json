{
  "name": "legion",
  "version": "2.0.1",
  "private": true,
  "description": "Legion: general-purpose and engineering skills plugin for Claude Code",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "validate:spec": "node scripts/validate-spec.mjs",
    "evals:triggers": "node scripts/trigger-evals.mjs",
    "evals:summarize": "node scripts/summarize-eval.mjs",
    "test:hooks": "bash tests/hooks/test-session-start.sh && bash tests/hooks/test-guard.sh",
    "test:scripts": "node --test \"tests/**/*.test.{mjs,cjs}\"",
    "test:shell": "node scripts/shellcheck.mjs",
    "test": "npm run validate && npm run validate:spec && npm run evals:triggers && npm run test:hooks && npm run test:scripts && npm run test:shell"
  },
  "engines": {
    "node": ">=22"
  }
}
